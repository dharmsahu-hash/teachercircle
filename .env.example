# --- hostname (local dev) ---
APP_HOSTNAME=localhost:3000

# --- generate with: openssl rand -hex 24  /  openssl rand -base64 48 ---
DB_PASSWORD=
JWT_SECRET=
MEILI_MASTER_KEY=
MINIO_ROOT_USER=teachercircle
MINIO_ROOT_PASSWORD=

# --- Google Cloud Console -> OAuth 2.0 Client (optional for local dev — leave blank to use email/password only) ---
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- your personal UPI ID, shown to payers, never a secret ---
UPI_PAYEE_VPA=yourname@upi
UPI_PAYEE_NAME=TeacherCircle

# --- internal service URLs (defaults match docker-compose service names, used by the app container) ---
POSTGREST_URL=http://postgrest:3000
GOTRUE_URL=http://gotrue:9999
GOTRUE_URL_BROWSER=http://localhost:9999
MEILISEARCH_URL=http://meilisearch:7700
REDIS_URL=redis://redis:6379
