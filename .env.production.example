# Production env vars — set these in Vercel (Project Settings -> Environment
# Variables), not in a committed file. This replaces the earlier Oracle
# Cloud VM plan: production now runs on Vercel (the Next.js app) + Supabase
# Cloud (Postgres + GoTrue + PostgREST, managed) — both free, no credit card.
# See docs/03-deployment.md Part B for the full walkthrough.

# The ONE public hostname, e.g. teacherscircle.co.in. No scheme, no path.
# Set it only after the domain shows "Valid Configuration" in Vercel (docs/03
# Step 4c): once set, every *.vercel.app request redirects to it. Until you have
# a custom domain, leave it blank or use your vercel.app hostname.
APP_HOSTNAME=

# Supabase project settings -> API. The same project URL, with /rest/v1 and
# /auth/v1 appended — Supabase's REST and Auth are literally PostgREST and
# GoTrue under the hood, same paths our code already expects.
POSTGREST_URL=https://<project-ref>.supabase.co/rest/v1
GOTRUE_URL=https://<project-ref>.supabase.co/auth/v1
GOTRUE_URL_BROWSER=https://<project-ref>.supabase.co/auth/v1

# Supabase project settings -> API -> the "publishable" key (starts
# sb_publishable_...). Safe to expose client-side by design — same security
# tier as the old "anon" key naming. Required on every request or Supabase's
# Kong gateway returns 401, even with a valid user bearer token — see
# lib/db.ts / lib/gotrue.ts.
SUPABASE_API_KEY=

# Google Cloud Console -> OAuth 2.0 Client, created fresh for production
# (never reuse the local-dev one). Authorized redirect URI to register:
# https://<project-ref>.supabase.co/auth/v1/callback — then paste the same
# Client ID/Secret into Supabase Dashboard -> Authentication -> Providers ->
# Google (that toggle lives in Supabase's control plane, not our database —
# nothing in this env file makes Google sign-in work on its own).
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your personal UPI ID — shown to payers, never a secret. Irrelevant while
# SUBSCRIPTION_UI_ENABLED is false in lib/featureToggles.ts.
UPI_PAYEE_VPA=yourname@upi
UPI_PAYEE_NAME=TeacherCircle

# Brevo (brevo.com) transactional email API key — sends the "new message"
# notification email to the other participant in a conversation. Without
# this, lib/email.ts no-ops silently rather than failing (a notification
# failure must never block sending the message itself), so messaging still
# works fully, just without emails. Free tier: 300 emails/day, no card.
BREVO_API_KEY=
# Optional — both have sane defaults in lib/email.ts if left unset.
EMAIL_SENDER_ADDRESS=no-reply@teachercircle.app
EMAIL_SENDER_NAME=TeacherCircle

# Google Analytics 4 — Analytics dashboard -> Admin -> Data Streams -> your
# web stream -> "Measurement ID" (starts G-...). Must be signed up for
# yourself in your own Google account first — Claude Code cannot create a
# Google Analytics property or agree to Google's terms on your behalf.
# Absent entirely (not broken) until this is set — see components/GoogleAnalytics.tsx.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense — after your site is approved, AdSense dashboard -> Account
# -> Account information -> "Publisher ID" (starts ca-pub-...). Same caveat:
# you have to sign up for AdSense, add the site, and get approved yourself —
# that's a real human review by Google, not something any code change can
# skip. Also absent (not broken) until set — see components/AdSense.tsx and
# app/ads.txt/route.ts (the latter needs this to publish a correct ads.txt,
# which AdSense requires for revenue to actually be attributed to you).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# No DB_PASSWORD / JWT_SECRET / MEILI_MASTER_KEY / MINIO_* here anymore —
# those were only needed to self-host Postgres/GoTrue/Meilisearch/MinIO
# directly, none of which this deployment does.

# Optional. How long (seconds) the shared teacher-directory reads are cached.
# Default: 300 in production, 0 elsewhere. 0 turns the cache off.
DIRECTORY_CACHE_SECONDS=

# Push alerts + teacher digest (migration 0030). Generate all of these with
#   node scripts/notify-setup.mjs
# Without them the features stay off and nothing is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 32+ random characters; the same value is the GitHub Actions secret CRON_SECRET
# and (as a SHA-256 hash) the row in the job_secret table.
CRON_SECRET=
# Optional. Most digest emails sent in one day (Brevo free plan: 300). Default 200.
DIGEST_DAILY_LIMIT=
