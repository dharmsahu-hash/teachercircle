# Copy to .env on the production VM (docker-compose.prod.yml reads .env, same
# as local dev — only the values below differ).

# Your free DuckDNS hostname (or a real domain if you bought one) — see
# docs/03-deployment.md step 2. No scheme, no path.
APP_HOSTNAME=teachercircle.duckdns.org

# Generate fresh secrets on the VM — do not reuse the ones from local dev:
#   openssl rand -hex 24     -> DB_PASSWORD, MEILI_MASTER_KEY, MINIO_ROOT_PASSWORD
#   openssl rand -base64 48  -> JWT_SECRET
DB_PASSWORD=
JWT_SECRET=
MEILI_MASTER_KEY=
MINIO_ROOT_USER=teachercircle
MINIO_ROOT_PASSWORD=

# Google Cloud Console -> OAuth 2.0 Client (see docs/03-deployment.md step 4).
# Authorized redirect URI to register: https://<APP_HOSTNAME>/auth/callback
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your personal UPI ID — shown to payers, never a secret.
UPI_PAYEE_VPA=yourname@upi
UPI_PAYEE_NAME=TeacherCircle
